# Copy to .env (or set these in your hosting dashboard). Never commit real values.

# Google Cloud project that has Vertex AI enabled
GCP_PROJECT_ID=your-gcp-project-id
# Vertex AI region, or "global"
GCP_LOCATION=us-central1
# Gemini model ID available on Vertex AI in that region
GEMINI_MODEL=gemini-3.8-flash

# Service-account JSON (full content, one line) with Vertex AI access
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...}
# API key with Speech-to-Text and Text-to-Speech enabled
GOOGLE_API_KEY=your-api-key

# Optional
LANGUAGE_CODE=en-US
TTS_VOICE=en-US-Journey-F
PORT=10000
